generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
  SALES
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum CompanyStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  IN
  OUT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  INVENTORY_ADJUSTMENT
  CONSUME
  PRODUCE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum FinanceDirection {
  IN
  OUT
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PARTIAL
  PAID
  CANCELLED
}

model User {
  id           String          @id @default(cuid())
  fullName     String
  email        String?         @unique
  phone        String?         @unique
  passwordHash String
  role         UserRole        @default(EMPLOYEE)
  status       UserStatus      @default(ACTIVE)
  avatar       String?
  jobTitle     String?
  lastActiveAt DateTime?
  deletedAt    DateTime?
  memberships  CompanyMember[]
  auditLogs    AuditLog[]      @relation("AuditActor")
  settings     UserSetting[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([role])
  @@index([createdAt])
}

model Company {
  id            String                @id @default(cuid())
  name          String
  businessName  String?
  businessType  String?
  phone         String?
  email         String?
  address       String?
  country       String?               @default("Uzbekistan")
  currency      String                @default("UZS")
  taxId         String?
  logo          String?
  status        CompanyStatus         @default(ACTIVE)
  ownerUserId   String?
  deletedAt     DateTime?
  members       CompanyMember[]
  modules       CompanyModuleAccess[]
  settings      CompanySetting[]
  branches      Branch[]
  warehouses    Warehouse[]
  products      Product[]
  categories    Category[]
  stockItems    StockItem[]
  stockMoves    StockMovement[]
  suppliers     Supplier[]
  purchases     Purchase[]
  sales         Sale[]
  customers     Customer[]
  agents        Agent[]
  cashboxes     Cashbox[]
  finance       FinanceTransaction[]
  boms          Bom[]
  production    ProductionOrder[]
  employees     Employee[]
  auditLogs     AuditLog[]
  batches       Batch[]
  batchConsumptions BatchConsumption[]
  inventoryCounts InventoryCount[]
  supplierPriceHistory SupplierPriceHistory[]
  inventoryPolicy String              @default("FEFO")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      UserRole @default(EMPLOYEE)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([role])
}

model Role {
  id          String           @id @default(cuid())
  key         String
  name        String
  companyId   String?
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model Permission {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model PlatformModule {
  id            String                @id @default(cuid())
  key           String                @unique
  name          String
  description   String?
  enabled       Boolean               @default(true)
  locked        Boolean               @default(false)
  companyAccess CompanyModuleAccess[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([enabled])
}

model CompanyModuleAccess {
  id        String         @id @default(cuid())
  companyId String
  moduleId  String
  enabled   Boolean        @default(true)
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    PlatformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  ip          String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model CompanySetting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     Json
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
  @@index([companyId])
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  key       String
  value     Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId, key])
  @@index([userId])
  @@index([companyId])
}

model Branch {
  id        String       @id @default(cuid())
  companyId String
  name      String
  status    RecordStatus @default(ACTIVE)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([companyId])
}

model Warehouse {
  id        String          @id @default(cuid())
  companyId String
  name      String
  code      String?
  address   String?
  status    RecordStatus    @default(ACTIVE)
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stock     StockItem[]
  movements StockMovement[]
  batches   Batch[]
  inventoryCounts InventoryCount[]
  purchases Purchase[]
  sales     Sale[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([status])
}

model Product {
  id            String          @id @default(cuid())
  companyId     String
  name          String
  sku           String
  barcode       String?
  type          String?
  category      String?
  categoryId    String?
  brand         String?
  unit          String          @default("dona")
  stock         Decimal         @default(0) @db.Decimal(18, 6)
  minimumStock  Decimal         @default(0) @db.Decimal(18, 6)
  reorderPoint  Decimal         @default(0) @db.Decimal(18, 6)
  cost          Decimal         @default(0) @db.Decimal(18, 2)
  salePrice     Decimal?        @db.Decimal(18, 2)
  tax           Decimal         @default(0) @db.Decimal(9, 2)
  discount      Decimal         @default(0) @db.Decimal(9, 2)
  image         String?
  notes         String?
  expiryDate    DateTime?
  normalWastePercent Decimal?   @db.Decimal(9, 4)
  parentProductId String?
  packSize      Decimal?        @db.Decimal(18, 6)
  packUnit      String?
  isVariant     Boolean         @default(false)
  status        RecordStatus    @default(ACTIVE)
  supplierId    String?
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  categoryRef   Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stockItems    StockItem[]
  batches       Batch[]
  supplierPriceHistory SupplierPriceHistory[]
  parentProduct Product?        @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: SetNull)
  variants      Product[]       @relation("ProductVariants")
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  bomOutputs    Bom[]
  bomMaterials  BomMaterial[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([categoryId])
  @@index([parentProductId])
}

model Category {
  id        String       @id @default(cuid())
  companyId String
  name      String
  status    RecordStatus @default(ACTIVE)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([companyId, name])
  @@index([companyId, status])
}

model StockItem {
  id           String    @id @default(cuid())
  companyId    String
  warehouseId  String
  productId    String
  quantity     Decimal   @default(0) @db.Decimal(18, 6)
  reserved     Decimal   @default(0) @db.Decimal(18, 6)
  cost         Decimal   @default(0) @db.Decimal(18, 2)
  minimumStock Decimal   @default(0) @db.Decimal(18, 6)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, warehouseId, productId])
  @@index([companyId])
  @@index([warehouseId])
  @@index([productId])
}

model StockMovement {
  id                     String            @id @default(cuid())
  companyId              String
  warehouseId            String
  destinationWarehouseId String?
  sourceWarehouseId      String?
  productId              String
  productName            String?
  type                   StockMovementType
  quantity               Decimal           @db.Decimal(18, 6)
  unit                   String?
  cost                   Decimal?          @db.Decimal(18, 2)
  reason                 String?
  sourceType             String?
  sourceId               String?
  idempotencyKey         String?
  note                   String?
  batchId                String?
  company                Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse              Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product                Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch                  Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdAt              DateTime          @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([warehouseId])
  @@index([productId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@index([batchId])
}

model Batch {
  id                String       @id @default(cuid())
  companyId         String
  batchNumber       String
  productId         String
  warehouseId       String
  quantity          Decimal      @default(0) @db.Decimal(18, 6)
  remainingQuantity Decimal      @default(0) @db.Decimal(18, 6)
  productionDate    DateTime?
  receivedDate      DateTime?
  expiryDate        DateTime?
  unitCost          Decimal      @default(0) @db.Decimal(18, 6)
  sourceType        String
  sourceId          String?
  status            RecordStatus @default(ACTIVE)
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product           Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  consumptions      BatchConsumption[]
  movements         StockMovement[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([companyId, batchNumber])
  @@index([companyId, productId, warehouseId])
  @@index([companyId, expiryDate])
  @@index([companyId, receivedDate])
}

model BatchConsumption {
  id             String   @id @default(cuid())
  companyId      String
  batchId        String
  productId      String
  warehouseId    String
  quantity       Decimal  @db.Decimal(18, 6)
  unitCost       Decimal  @db.Decimal(18, 6)
  sourceType     String
  sourceId       String
  idempotencyKey String?
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch          Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId, productId, warehouseId])
  @@index([sourceType, sourceId])
}

model Supplier {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  debtBalance   Decimal      @default(0) @db.Decimal(18, 2)
  status        RecordStatus @default(ACTIVE)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products      Product[]
  purchases     Purchase[]
  priceHistory  SupplierPriceHistory[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([companyId])
  @@index([companyId, status])
}

model Purchase {
  id            String               @id @default(cuid())
  companyId     String
  number        String
  supplierId    String?
  supplierName  String?
  warehouseId   String?
  warehouseName String?
  status        PurchaseStatus       @default(ORDERED)
  subtotal      Decimal              @default(0) @db.Decimal(18, 2)
  total         Decimal              @default(0) @db.Decimal(18, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(18, 2)
  debtAmount    Decimal              @default(0) @db.Decimal(18, 2)
  expectedDate  DateTime?
  orderDate     DateTime?
  receivedAt    DateTime?
  cancelledAt   DateTime?
  note          String?
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse     Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items         PurchaseItem[]
  payments      FinanceTransaction[] @relation("PurchaseFinance")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id               String   @id @default(cuid())
  purchaseId       String
  productId        String?
  productName      String
  sku              String?
  quantity         Decimal  @db.Decimal(18, 6)
  purchaseQuantity Decimal? @db.Decimal(18, 6)
  receivedQuantity Decimal  @default(0) @db.Decimal(18, 6)
  unit             String   @default("dona")
  purchaseUnit     String?
  cost             Decimal  @default(0) @db.Decimal(18, 2)
  salePrice        Decimal? @db.Decimal(18, 2)
  subtotal         Decimal  @default(0) @db.Decimal(18, 2)
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model Customer {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  fullName      String?
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  type          String       @default("INDIVIDUAL")
  region        String?
  agentId       String?
  creditLimit   Decimal      @default(0) @db.Decimal(18, 2)
  segment       String       @default("NEW")
  tags          Json?
  notes         Json?
  followUps     Json?
  debtBalance   Decimal      @default(0) @db.Decimal(18, 2)
  status        RecordStatus @default(ACTIVE)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sales         Sale[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  @@index([companyId])
  @@index([companyId, status])
  @@index([agentId])
}

model Agent {
  id             String       @id @default(cuid())
  companyId      String
  name           String
  phone          String?
  email          String?
  targetAmount   Decimal      @default(0) @db.Decimal(18, 2)
  commissionRate Decimal      @default(0) @db.Decimal(9, 2)
  balance        Decimal      @default(0) @db.Decimal(18, 2)
  status         RecordStatus @default(ACTIVE)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customers      Customer[]
  sales          Sale[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([companyId])
  @@index([companyId, status])
}

model Sale {
  id             String               @id @default(cuid())
  companyId      String
  number         String
  customerId     String?
  customerName   String?
  agentId        String?
  agentName      String?
  warehouseId    String?
  warehouseName  String?
  subtotal       Decimal              @default(0) @db.Decimal(18, 2)
  discountType   String               @default("AMOUNT")
  discountValue  Decimal              @default(0) @db.Decimal(18, 2)
  discount       Decimal              @default(0) @db.Decimal(18, 2)
  total          Decimal              @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal              @default(0) @db.Decimal(18, 2)
  debtAmount     Decimal              @default(0) @db.Decimal(18, 2)
  paymentStatus  String?
  paymentMethod  String?
  status         SaleStatus           @default(DRAFT)
  returnStatus   String?
  returnedAmount Decimal              @default(0) @db.Decimal(18, 2)
  netTotal       Decimal              @default(0) @db.Decimal(18, 2)
  cogs           Decimal              @default(0) @db.Decimal(18, 6)
  profit         Decimal              @default(0) @db.Decimal(18, 6)
  orderDate      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  note           String?
  idempotencyKey String?
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  agent          Agent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]
  finance        FinanceTransaction[] @relation("SaleFinance")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([agentId])
  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  sku         String?
  barcode     String?
  quantity    Decimal  @db.Decimal(18, 6)
  unit        String   @default("dona")
  price       Decimal  @db.Decimal(18, 2)
  cost        Decimal  @default(0) @db.Decimal(18, 2)
  subtotal    Decimal  @db.Decimal(18, 2)
  cogs        Decimal  @default(0) @db.Decimal(18, 6)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id             String   @id @default(cuid())
  saleId         String
  method         String   @default("CASH")
  amount         Decimal  @db.Decimal(18, 2)
  idempotencyKey String?
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([saleId, idempotencyKey])
  @@index([saleId])
}

model SaleReturn {
  id           String   @id @default(cuid())
  saleId       String
  productId    String?
  productName  String
  sku          String?
  quantity     Decimal  @db.Decimal(18, 6)
  unit         String   @default("dona")
  refundAmount Decimal  @default(0) @db.Decimal(18, 2)
  reason       String?
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model Cashbox {
  id        String               @id @default(cuid())
  companyId String
  name      String
  currency  String               @default("UZS")
  balance   Decimal              @default(0) @db.Decimal(18, 2)
  status    RecordStatus         @default(ACTIVE)
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  txns      FinanceTransaction[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model FinanceTransaction {
  id             String           @id @default(cuid())
  companyId      String
  cashboxId      String?
  type           FinanceDirection
  category       String?
  amount         Decimal          @db.Decimal(18, 2)
  method         String?
  description    String?
  sourceType     String?
  sourceId       String?
  idempotencyKey String?
  customerId     String?
  supplierId     String?
  agentId        String?
  employeeId     String?
  saleId         String?
  purchaseId     String?
  payrollId      String?
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cashbox        Cashbox?         @relation(fields: [cashboxId], references: [id], onDelete: SetNull)
  sale           Sale?            @relation("SaleFinance", fields: [saleId], references: [id], onDelete: SetNull)
  purchase       Purchase?        @relation("PurchaseFinance", fields: [purchaseId], references: [id], onDelete: SetNull)
  payroll        Payroll?         @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([sourceType, sourceId])
  @@index([customerId])
  @@index([supplierId])
  @@index([agentId])
  @@index([employeeId])
  @@index([createdAt])
}

model Bom {
  id                String            @id @default(cuid())
  companyId         String
  name              String
  outputProductId   String?
  outputProductName String?
  outputQuantity    Decimal           @default(1) @db.Decimal(18, 6)
  unit              String            @default("dona")
  overheadCost      Decimal           @default(0) @db.Decimal(18, 2)
  status            RecordStatus      @default(ACTIVE)
  version           Int               @default(1)
  versionGroupId    String?
  normalWastePercent Decimal?         @db.Decimal(9, 4)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  outputProduct     Product?          @relation(fields: [outputProductId], references: [id], onDelete: SetNull)
  materials         BomMaterial[]
  orders            ProductionOrder[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, versionGroupId])
}

model BomMaterial {
  id          String   @id @default(cuid())
  bomId       String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(18, 6)
  unit        String   @default("dona")
  cost        Decimal  @default(0) @db.Decimal(18, 2)
  bom         Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([bomId])
  @@index([productId])
}

model ProductionOrder {
  id                String            @id @default(cuid())
  companyId         String
  number            String
  bomId             String?
  outputProductId   String?
  outputProductName String?
  unit              String            @default("dona")
  plannedQuantity   Decimal           @db.Decimal(18, 6)
  actualQuantity    Decimal           @default(0) @db.Decimal(18, 6)
  acceptedQuantity  Decimal           @default(0) @db.Decimal(18, 6)
  defectQuantity    Decimal           @default(0) @db.Decimal(18, 6)
  wasteQuantity     Decimal           @default(0) @db.Decimal(18, 6)
  yieldPercent      Decimal           @default(0) @db.Decimal(9, 4)
  wastePercent      Decimal           @default(0) @db.Decimal(9, 4)
  recipeVersion     Int?
  recipeSnapshot    Json?
  packaging         Json?
  remainingBulkQuantity Decimal       @default(0) @db.Decimal(18, 6)
  warehouseId       String?
  status            ProductionStatus  @default(PLANNED)
  materialCost      Decimal           @default(0) @db.Decimal(18, 2)
  overheadCost      Decimal           @default(0) @db.Decimal(18, 2)
  productionCost    Decimal           @default(0) @db.Decimal(18, 2)
  unitCost          Decimal           @default(0) @db.Decimal(18, 2)
  actualMaterialCost Decimal          @default(0) @db.Decimal(18, 6)
  actualProductionCost Decimal        @default(0) @db.Decimal(18, 6)
  actualUnitCost    Decimal           @default(0) @db.Decimal(18, 6)
  currency          String            @default("UZS")
  costingPolicy     String            @default("CURRENT_AT_START")
  materialSnapshot  Json?
  actualMaterials   Json?
  overheadItems     Json?
  qualityControl    Json?
  qualityStatus     String?
  qualityNote       String?
  completionNote    String?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  note              String?
  idempotencyKey    String?
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bom               Bom?              @relation(fields: [bomId], references: [id], onDelete: SetNull)
  stages            ProductionStage[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([companyId, status])
  @@index([bomId])
}

model ProductionStage {
  id        String          @id @default(cuid())
  orderId   String
  name      String
  status    ProductionStatus @default(PLANNED)
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Employee {
  id         String       @id @default(cuid())
  companyId  String
  fullName   String
  phone      String?
  email      String?
  position   String?
  salary     Decimal      @default(0) @db.Decimal(18, 2)
  status     RecordStatus @default(ACTIVE)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shifts     Shift[]
  attendance Attendance[]
  payrolls   Payroll[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  @@index([companyId])
  @@index([companyId, status])
}

model Shift {
  id         String    @id @default(cuid())
  companyId  String
  employeeId String?
  name       String
  startTime  String?
  endTime    String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@index([employeeId])
}

model Attendance {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       DateTime
  status     String   @default("PRESENT")
  checkIn    DateTime?
  checkOut   DateTime?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([companyId, employeeId, date])
  @@index([companyId])
  @@index([employeeId])
}

model Payroll {
  id          String               @id @default(cuid())
  companyId   String
  employeeId  String
  period      String
  grossAmount Decimal              @default(0) @db.Decimal(18, 2)
  advances    Decimal              @default(0) @db.Decimal(18, 2)
  bonuses     Decimal              @default(0) @db.Decimal(18, 2)
  penalties   Decimal              @default(0) @db.Decimal(18, 2)
  netAmount   Decimal              @default(0) @db.Decimal(18, 2)
  paidAmount  Decimal              @default(0) @db.Decimal(18, 2)
  debtAmount  Decimal              @default(0) @db.Decimal(18, 2)
  status      PayrollStatus        @default(DRAFT)
  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  finance     FinanceTransaction[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([companyId, employeeId, period])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
}

model InventoryCount {
  id             String   @id @default(cuid())
  companyId      String
  warehouseId    String
  productId      String
  systemQuantity Decimal  @db.Decimal(18, 6)
  actualQuantity Decimal  @db.Decimal(18, 6)
  difference     Decimal  @db.Decimal(18, 6)
  reason         String
  approvedBy     String?
  adjustmentId   String?
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([companyId, warehouseId, productId])
  @@index([createdAt])
}

model SupplierPriceHistory {
  id         String   @id @default(cuid())
  companyId  String
  supplierId String?
  productId  String
  date       DateTime @default(now())
  unit       String
  price      Decimal  @db.Decimal(18, 6)
  currency   String
  sourceType String?
  sourceId   String?
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, date])
  @@index([supplierId, productId])
}
